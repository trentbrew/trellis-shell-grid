{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grid",
  "version": "0.1.0",
  "identifier": "com.turtle.grid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grid",
        "width": 1600,
        "height": 1000,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$HOME/**", "$HOME/.grid/**", "/Users/**", "/home/**", "/tmp/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
